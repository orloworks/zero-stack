{
  "name": "create-zero-stack",
  "version": "0.1.0",
  "description": "Scaffold a Void (Cloudflare Workers) app: wraps create-void and adds Tailwind, shadcn, zod RPC and auth",
  "keywords": [
    "void",
    "cloudflare",
    "workers",
    "scaffold",
    "create",
    "bun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orloworks/zero-stack.git"
  },
  "homepage": "https://github.com/orloworks/zero-stack#readme",
  "bugs": {
    "url": "https://github.com/orloworks/zero-stack/issues"
  },
  "type": "module",
  "bin": {
    "create-zero-stack": "src/index.ts"
  },
  "files": [
    "src",
    "template",
    "docs/cloudflare-routing.md",
    "skills"
  ],
  "engines": {
    "node": "^24.22.0 || >=26.12.0"
  },
  "scripts": {
    "test": "bun test tests/unit",
    "link-skill": "bun scripts/link-skill.ts",
    "typecheck": "tsc -p . --noEmit",
    "ci": "bun run typecheck && bun test tests/unit && bun scripts/gate.ts --tailwind --shadcn --zod-rpc --auth",
    "ci:full": "bun scripts/ci-full.ts",
    "setup-hooks": "bun scripts/setup-hooks.ts",
    "prepublishOnly": "bun run ci:full"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0"
  }
}
